# On-site client demo — copy to .env before travel:
#   cp .env.demo.example .env
#   php artisan key:generate
#   php artisan migrate:fresh
#
# Do NOT run PlaywrightSeeder for client demo — register org via /register at client site.

APP_NAME="BK Portal Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite is fastest for laptop demo; switch to mysql if you prefer.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bk_demo
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Local demo (add LAN IP when staff join same WiFi — see scripts/demo-lan-env.sh)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

SANCTUM_TOKEN_EXPIRATION=480
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
